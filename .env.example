# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.
FLASK_ENV=development
SECRET_KEY=замените-на-длинную-случайную-строку
# Подключение к PostgreSQL: либо одна строка...
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# ...либо по частям:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=dbname
# DATABASE_USER=user
# DATABASE_PASSWORD=password
# Запуск dev-сервера (по умолчанию 127.0.0.1:5000, debug выключен)
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5000
# FLASK_DEBUG=0
# SESSION_COOKIE_SECURE=true   # включить при работе по HTTPS
