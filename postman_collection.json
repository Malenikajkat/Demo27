                  "pm.test(\"Each note has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.notes.length > 0) {",
                  "        var note = jsonData.notes[0];",
                  "        pm.expect(note).to.have.property('id');",
                  "        pm.expect(note).to.have.property('title_user');",
                  "        pm.expect(note).to.have.property('content');",
                  "        pm.expect(note).to.have.property('formatted_date');",
                  "        \n",
                  "        // Проверка формата title_user: \"{title} - {login}\"",
                  "        pm.expect(note.title_user).to.include(' - ');",
                  "        \n",
                  "        // Проверка формата даты: ДД.ММ.ГГГГ",
                  "        pm.expect(note.formatted_date).to.match(/^\\d{2}\\.\\d{2}\\.\\d{4}$/);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Total count matches\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total).to.be.a('number');",
