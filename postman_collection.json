                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Cost calculation has all required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('sales_order_id');",
                  "    pm.expect(jsonData).to.have.property('order_number');",
                  "    pm.expect(jsonData).to.have.property('customer_name');",
                  "    pm.expect(jsonData).to.have.property('executor_name');",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData).to.have.property('total_material_cost');",
                  "    pm.expect(jsonData).to.have.property('total_operation_cost');",
                  "    pm.expect(jsonData).to.have.property('total_production_cost');",
                  "    pm.expect(jsonData).to.have.property('calculated_total');",
                  "    pm.expect(jsonData).to.have.property('difference');",
                  "});",
                  "",
                  "pm.test(\"Cost calculation returns items\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.items.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Each cost item has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.items.length > 0) {",
                  "        var item = jsonData.items[0];",
                  "        pm.expect(item).to.have.property('product_name');",
                  "        pm.expect(item).to.have.property('ordered_quantity');",
                  "        pm.expect(item).to.have.property('material_cost_per_unit');",
                  "        pm.expect(item).to.have.property('operation_cost_per_unit');",
                  "        pm.expect(item).to.have.property('total_cost_per_unit');",
                  "        pm.expect(item).to.have.property('line_total');",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Production cost is calculated correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total_production_cost).to.be.greaterThan(0);",
                  "    pm.expect(jsonData.total_material_cost).to.be.greaterThan(0);",
                  "    pm.expect(jsonData.total_operation_cost).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
